{
  "compilerOptions": {
    "types": [
      "vitest/globals",
      "@wdio/globals/types",
      "@wdio/mocha-framework",
      "wdio-obsidian-service"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
    },
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "nodenext",
    "target": "ES6",
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "nodenext",
    "importHelpers": true,
    "isolatedModules": true,
    "strictNullChecks": true,
    "lib": [
      "DOM",
      "ES5",
      "ES6",
      "ES7"
    ]
  },
  "include": [
    "src/**/*.ts"
  ]
}