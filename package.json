{
  "name": "obsidian-jupyter",
  "description": "Open and edit Jupyter notebooks directly inside of Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest --reporter=verbose --run && wdio run ./wdio.conf.ts",
    "test:unit": "vitest --reporter=verbose --run",
    "test:e2e": "wdio run ./wdio.conf.ts",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "5.29.0",
    "@typescript-eslint/parser": "5.29.0",
    "@wdio/cli": "^9.15.0",
    "@wdio/globals": "^9.15.0",
    "@wdio/local-runner": "^9.15.0",
    "@wdio/mocha-framework": "^9.15.0",
    "@wdio/spec-reporter": "^9.15.0",
    "@wdio/types": "^9.15.0",
    "builtin-modules": "3.3.0",
    "esbuild": "0.17.3",
    "mocha": "^11.6.0",
    "obsidian": "latest",
    "tslib": "^2.4.0",
    "typescript": "4.7.4",
    "vitepress": "^1.6.3",
    "vitepress-plugin-llms": "^1.7.0",
    "vitest": "^3.1.2",
    "wdio-obsidian-reporter": "^1.3.0",
    "wdio-obsidian-service": "^1.3.0"
  },
  "dependencies": {
    "emittery": "^1.2.0"
  }
}
